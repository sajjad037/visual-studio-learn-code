# .env.example — TradingAgents v0.7.1 run configuration used in the
# Visual Studio Learn "Open-Source Agent, Tested #1" episode
# (NVDA, analysis date 2026-10-09, tested October 31, 2026).
#
# Copy to .env and fill in your own key, or export the same variables
# in your shell. NEVER commit a real API key.

# Google (Gemini) provider key — free at aistudio.google.com
GOOGLE_API_KEY=PASTE_YOUR_KEY

# Provider
TRADINGAGENTS_LLM_PROVIDER=google

# Model pair that COMPLETED the test (attempt 5, 107 seconds):
# two free-tier buckets the earlier attempts had not touched.
TRADINGAGENTS_DEEP_THINK_LLM=gemini-3.5-flash
TRADINGAGENTS_QUICK_THINK_LLM=gemini-3.1-flash-lite

# First pair we ran (attempts 1-3) — its free-tier daily caps ran out
# mid-test: 20 requests/day for gemini-3.8-flash, 15/day for
# gemini-3.5-flash-lite (per project, per model). Uncomment to use:
# TRADINGAGENTS_DEEP_THINK_LLM=gemini-3.8-flash
# TRADINGAGENTS_QUICK_THINK_LLM=gemini-3.5-flash-lite

# Output
TRADINGAGENTS_OUTPUT_LANGUAGE=English

# Debate depth — one round each, as tested
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Checkpointing — lets an interrupted run save its place (see the
# honest note in run-test.sh: in this test a resume restarted from
# the beginning instead of resuming).
TRADINGAGENTS_CHECKPOINT_ENABLED=true

# Retries — left at the framework default in our test (the framework's
# own one automatic free-text retry was observed in attempts 2-3).
# Uncomment to set explicitly:
# TRADINGAGENTS_LLM_MAX_RETRIES=3

# Optional data keys — not set in our test; the framework noted the
# missing FRED key, skipped that source, and carried on.
# FRED_API_KEY=
# ALPHA_VANTAGE_API_KEY=
