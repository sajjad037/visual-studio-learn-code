# Example values only. These use Windows Authentication; no password is stored.

# C# variant: LocalDB (the default in Program.cs)
SQLCONN=Server=(localdb)\MSSQLLocalDB;Database=SqlConnectDemo;Integrated Security=true;Encrypt=true;TrustServerCertificate=true;

# C# variant: SQL Server Developer edition named instance.
# Replace HOSTNAME and INSTANCE with the names from your local installation.
# SQLCONN=Server=HOSTNAME\INSTANCE;Database=SqlConnectDemo;Integrated Security=true;Encrypt=true;TrustServerCertificate=true;

# Python variant: LocalDB through ODBC Driver 18
SQLCONN_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=(localdb)\MSSQLLocalDB;DATABASE=SqlConnectDemo;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;

# Python variant: SQL Server Developer edition named instance.
# SQLCONN_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=HOSTNAME\INSTANCE;DATABASE=SqlConnectDemo;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;
